{
  "name": "vinpearl-iphone-automation-manager",
  "version": "0.1.0",
  "private": true,
  "description": "macOS desktop manager for authorized iPhones through local Appium/XCUITest",
  "main": "dist-electron/src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "node scripts/run-electron.cjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:workflow": "node scripts/check-workflow.cjs",
    "check:appium": "node scripts/check-appium.cjs",
    "check:database": "node scripts/check-database.cjs",
    "check": "npm run typecheck && npm run build && npm run check:workflow && npm run check:appium && npm run check:database",
    "package:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.vinpearl.iphone-automation-manager",
    "productName": "Vinpearl iPhone Manager",
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
